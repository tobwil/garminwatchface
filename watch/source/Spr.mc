import Toybox.Graphics;
import Toybox.Lang;

// Spr — palette-indexed pixel sprites. Mirrors web/js/engine/spr.js.
// Sprite data: ByteArray [w, h, px...] with 255 = transparent (generated by tools/spritegen.mjs).
module Spr {
    // Draw sprite s at (x, y) (top-left) with pixel size sc. pal = colours by index
    // (-1 skips that index). flip = mirror horizontally.
    function draw(dc as Dc, s as ByteArray, x, y, sc, pal as Array, flip as Boolean) as Void {
        var w = s[0];
        var h = s[1];
        var np = pal.size();
        for (var row = 0; row < h; row++) {
            var base = 2 + row * w;
            var col = 0;
            while (col < w) {
                var v = s[base + (flip ? w - 1 - col : col)];
                var end = col + 1;
                while (end < w && s[base + (flip ? w - 1 - end : end)] == v) {
                    end++;
                }
                if (v != 255 && v < np) {
                    var c = pal[v];
                    if (c != -1) {
                        dc.setColor(c, -1);
                        dc.fillRectangle(x + col * sc, y + row * sc, (end - col) * sc, sc);
                    }
                }
                col = end;
            }
        }
    }

    function w(s as ByteArray, sc) {
        return s[0] * sc;
    }

    function h(s as ByteArray, sc) {
        return s[1] * sc;
    }
}
